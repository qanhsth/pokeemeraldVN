MoveTutor_Text_ThisMoveCanOnlyBeLearnedOnce:
	.string "Chiêu này học được duy nhất\n"
	.string "một lần thôi nha?$"

MoveTutor_Text_SwaggerTeach:
	.string "Ê! POKéMON của tui ghê lắm đó!\n"
	.string "Ngầu hơn mấy con POKéMON khác luôn!\p"
	.string "Tui đang nói chuyện kiểu NGẠO MẠN với\n"
	.string "phong thái ngầu lòi thì CHỦ TỊCH\l"
	.string "rầy tui 1 tăng.\p"
	.string "Làm tui hết dám NGẠO MẠN luôn.\p"
	.string "Nếu thích, thì tui sẽ dạy\n"
	.string "NGẠO MẠN cho POKéMON của bạn.$" 

MoveTutor_Text_SwaggerDeclined:
	.string "Không thích hả? Bạn thiệt là\n"
	.string "không biết ý tứ gì hết!$"

MoveTutor_Text_SwaggerWhichMon:
	.string "Vậy rồi, cho POKéMON nào\n"
	.string "học NGẠO MẠN?$"

MoveTutor_Text_SwaggerTaught:
	.string "Từ giờ trở đi, tui chỉ khen POKéMON\n"
    .string "của mình thôi, không NGẠO MẠN nữa.$"

MoveTutor_Text_RolloutTeach:
    .string "Bạn có biết là bạn có thể đi\n"
    .string "một đoạn đường dài từ đây\l"
    .string "mà không cần đổi hướng không?\p"
	.string "Thậm chí là còn có thể lăn mình\n"
    .string "theo một đường thẳng.\p"
    .string "Bạn có nghĩ POKéMON của bạn cũng\n"
    .string "muốn lăn mình không?\p"
    .string "Tui có thể dạy nó chiêu LĂN XẢ\n"
    .string "nếu bạn muốn.$"

MoveTutor_Text_RolloutDeclined:
    .string "Bạn không cần phải ngại đâu.\n"
    .string "Lăn hết mình đi!$"

MoveTutor_Text_RolloutWhichMon:
    .string "Ehehe, chắc chắn rồi! Sẽ rất vui\n"
    .string "nếu POKéMON cũng làm giống tui.$"

MoveTutor_Text_RolloutTaught:
    .string "Lăn lộn trên cỏ làm tui\n"
    .string "vui quá. Lăn tiếp thôi!$"

MoveTutor_Text_FuryCutterTeach:
    .string "Có một chiêu thức gây ST mạnh hơn\n"
    .string "khi bạn liên tục sử dụng.\p"
    .string "Đó là chiêu thức hệ BỌ, và nó\n"
    .string "thật sự rất ngầu.\p"
	.string "Tên chiêu thức đó là CUỒNG TRẢM.\n"
	.string "Muốn tui dạy cho POKéMON không?$"

MoveTutor_Text_FuryCutterDeclined:
	.string "Không cùng tần số rồi.$"

MoveTutor_Text_FuryCutterWhichMon:
	.string "Yay!\n"
	.string "Đưa POKéMON cho tui dạy nè.$"

MoveTutor_Text_FuryCutterTaught:
    .string "Xài chiêu xong, tui hay hồi hộp lắm,\n"
    .string "tại không biết có trúng tiếp hay không!$"

MoveTutor_MimicTeach:
	.string "Ah, người trẻ tuổi!\p"
	.string "Tui cũng trẻ tuổi, mà tui bắt chước\n"
	.string "phong thái và giọng nói của người già\l"
	.string "ở thành phố này.\p"
	.string "Bạn nghĩ sao, người trẻ tuổi?\n"
	.string "Bạn có đồng ý để tui dạy cho\l"
	.string "chiêu BẮT CHƯỚC không?$"

MoveTutor_MimicDeclined:
	.string "Ububu! Tui muốn dạy\n"
	.string "BẮT CHƯỚC cho POKéMON của bạn!$"

MoveTutor_Text_MimicWhichMon:
	.string "Hú hú! Tui rất sẵn lòng!\n"
	.string "Cho tui coi POKéMON\l"
	.string "mà bạn muốn tui dạy.$"

MoveTutor_Text_MimicTaught:
	.string "BẮT CHƯỚC là chiêu thức có chiều sâu.\p"
	.string "Bạn có thể thành thạo\n"
	.string "được như tui không…?$"

MoveTutor_Text_MetronomeTeach:
	.string "Tui muốn có tất cả mọi thứ!\n"
	.string "Mà tui hết tiền trợ cấp rồi…\p"
	.string "Nếu mà có phép thuật làm cho\n"
	.string "tiền rớt ra khi mà mình vẫy\l"
	.string "ngón tay thì hay ha?\p"
	.string "Nếu muốn, tui sẽ dạy cho POKéMON\n"
	.string "của bạn chiêu NGẪU NHIÊN.\p"
	.string "Tiền sẽ không rớt ra, mà POKéMON\n"
	.string "sẽ vẫy ngón tay á. Được không?$"

MoveTutor_Text_MetronomeDeclined:
	.string "Vậy thôi. Tui sẽ ở đây chờ\n"
	.string "bạn đổi ý.$"

MoveTutor_Text_MetronomeWhichMon:
	.string "Rồi! Để tui dạy cho!\n"
	.string "Bạn muốn POKéMON nào học?$"

MoveTutor_Text_MetronomeTaught:
	.string "POKéMON mà vẫy ngón tay\n"
	.string "giống như MÁY ĐẾM NHỊP,\l"
	.string "những thứ đẹp đẽ sẽ hiện ra.\p"
	.string "Nếu mà tụi mình cũng xài được\n"
	.string "thì hay ha?$"

MoveTutor_Text_SleepTalkTeach:
	.string "Hực! Vợ ta chỉ dựa vô\n"
	.string "THỨC TỈNH để tỉnh giấc thôi.\p"
	.string "Bả cũng nên làm 1 giấc như ta,\n"
	.string "rồi NGỦ MỚ đi chứ.\p"
	.string "Ta có thể dạy cho POKéMON chiêu\n"
	.string "NGỦ MỚ. Chịu không?$"

MoveTutor_Text_SleepTalkDeclined:
	.string "Ủa, vậy thôi, vậy thôi, Vậy là con muốn\n"
	.string "tự tỉnh giấc bằng THỨC TỈNH…$"

MoveTutor_Text_SleepTalkWhichMon:
	.string "Aa, ngoan quá!\n"
	.string "Con muốn POKéMON nào học?$"

MoveTutor_Text_SleepTalkTaught:
	.string "Ta chưa bao giờ đoán trúng\n"
	.string "mẹo đồng xu của vợ ta.\p"
	.string "Sẽ rất vui nếu ta đoán trúng\n"
	.string "kể cả khi đang NGỦ MỚ…$"

MoveTutor_Text_SubstituteTeach:
	.string "Ngắm nhìn thế giới rộng lớn từ trên\n"
    .string "mái nhà cao vời vợi này…\p"
    .string "Tui nghĩ là sẽ thật thú vị nếu\n"
    .string "có nhiều hơn một phiên bản của tui\l"
    .string "để tui có thể tận hưởng đủ kiểu sống.\p"
    .string "Tất nhiên là điều đó không thể xảy ra.\n"
	.string "Hí hí…\p"
	.string "Biết rồi! Bạn muốn cho\n"
	.string "POKéMON học THẾ THÂN đúng không?$"

MoveTutor_Text_SubstituteDeclined:
	.string "Hong hả?\p"
	.string "POKéMON có thể thi triển\n"
	.string "chiêu đó để tạo bản sao á.$"

MoveTutor_Text_SubstituteWhichMon:
	.string "Hí hí…\n"
	.string "Bạn muốn tui dạy THẾ THÂN\l"
	.string "cho POKéMON nào?$"

MoveTutor_Text_SubstituteTaught:
	.string "Con người chúng ta nên tận hưởng\n"
    .string "cuộc sống một cách trọn vẹn nhất!\p"
    .string "Hy vọng bạn cũng sẽ làm vậy!$"

MoveTutor_Text_DynamicPunchTeach: 
	.string "Tui hết chịu nỗi rồi!\p"
	.string "Vô vọng quá!\p"
	.string "Tui là NHL chơi hệ VÕ SĨ,\n"
	.string "nên không thắng được NHÀ THI ĐẤU\l"
	.string "XANH RÊU, dù cố tới đâu!\p"
	.string "Argh! Đấm! Đấm! Đấm!\n"
	.string "Đấm! Đấm! Đấm!\p"
	.string "Đừng có nhìn tui kiểu đó!\n"
	.string "Tui chỉ đấm chơi thôi!\p"
	.string "Ha là bạn muốn tui dạy cho\n"
	.string "POKéMON chiêu ĐẤM NGẤT?$"

MoveTutor_Text_DynamicPunchDeclined:
	.string "Chết tiệt! Còn cười tui nữa?\n"
	.string "Đấm! Đấm! Đấm!$"

MoveTutor_Text_DynamicPunchWhichMon:
	.string "Hả? Muốn hả? Bạn là người tốt!\n"
	.string "Dạy cho POKéMON nào?$"

MoveTutor_Text_DynamicPunchTaught:
	.string "Tui muốn bạn thắng NHÀ THI ĐẤU\n"
	.string "XANH RÊU bằng cú ĐẤM NGẤT đó!$"

MoveTutor_Text_DoubleEdgeTeach:
	.string "Thở dài…\p"
	.string "CHỦ GYM LƯU NIẾT thiệt là\n"
	.string "dễ mến và đáng ngưỡng mộ.\p"
	.string "Điều đó có nghĩa là tui đang\n"
	.string "có quá nhiều đối thủ.\p"
	.string "Ảnh có hứng thú với CHƠI LIỀU.\n"
	.string "Tui không thể nào rời mắt ảnh được.\p"
	.string "Làm ơn, hãy cho tui dạy POKéMON\n"
	.string "của bạn chiêu CHƠI LIỀU đi!$"

MoveTutor_Text_DoubleEdgeDeclined:
	.string "Ụaaủaa…\n"
	.string "Bạn cũng từ chối tui luôn…$"

MoveTutor_Text_DoubleEdgeWhichMon:
	.string "Rồi, tui nên dạy cho POKéMON nào\n"
	.string "biết chiêu CHƠI LIỀU?$"

MoveTutor_Text_DoubleEdgeTaught:
	.string "Tui sẽ không sống vì tình yêu nữa!\n"
	.string "Tui sẽ mạnh lên!$"

MoveTutor_Text_ExplosionTeach:
	.string "Tui không có ý định ở hoài một\n"
    .string "chỗ, ở vùng quê hẻo lánh như vầy.\p"
    .string "Cứ chờ đi, tui sẽ ra phố thị và\n"
    .string "trở thành một hiện tượng đình đám.\p"
	.string "Thiệt mà, tui sẽ gây ra một\n"
    .string "vụ NỔ lớn chấn động cho coi!\p"
    .string "Nếu có tình cờ nghe được, tui sẵn lòng\n"
    .string "dạy chiêu PHÁT NỔ cho POKÉMON của bạn!$"

MoveTutor_Text_ExplosionDeclined:
	.string "Gừraaaa! Bạn từ chối là tại\n"
	.string "tui sống ở miền quê hả?$"

MoveTutor_Text_ExplosionWhichMon:
	.string "Được! PHÁT NỔ luôn!\n"
	.string "Bạn muốn cho POKéMON nào nổ đây?$"

MoveTutor_Text_ExplosionTaught:
	.string "Hồi xưa, tui có dạy cho POKéMON\n"
	.string "biết xài PHÁT NỔ, nhưng mà tui\l"
	.string "vẫn chưa thử PHÁT NỔ bao giờ…\p"
	.string "Có lẽ sâu thẳm trong lòng,\n"
	.string "tui thà ở lại đây còn hơn…$"
