gText_Birch_Welcome::
	.string "Chào con! Đợi lâu chưa!?\p"
	.string "Chào mừng con đến với thế giới POKéMON!\p"
	.string "Chú là Bình.\p"
	.string "Người đời gọi chú là TIẾN SĨ\n"
	.string "POKéMON.\p"
	.string "$"

gText_Birch_Pokemon::
	.string "Đây là sinh vật, có tên là\p"
	.string "“POKéMON.”\n"
	.string "$"

gText_Birch_MainSpeech::
	.string "Thế giới này có rất nhiều\n"
	.string "sinh vật diệu kỳ gọi là POKéMON.\p"
	.string "Chúng ta chung sống với POKéMON,\n"
	.string "coi tụi nó như người bạn, hoặc là\l"
	.string "cộng sự.\p"
	.string "Và đôi lúc, ta cùng nhau chiến đấu\n"
	.string "với các NHL (NHÀ HUẤN LUYỆN) khác.\p"
	.string "Cho dù có kết thân cỡ nào đi nữa,\n"
	.string "ta không thể biết hết về POKéMON.\p"
	.string "Thực tế, có rất, rất nhiều\n"
	.string "điều chưa bật mí về POKéMON.\p"
	.string "Để biết thêm về POKéMON,\n"
	.string "Chú đang làm nghiên cứu.\l"
	.string "Như con có thể thấy.\p"
	.string "$"

gText_Birch_AndYouAre::
	.string "Mà con là?$"

gText_Birch_BoyOrGirl::
	.string "Trai?\n"
	.string "Hay gái?$"

gText_Birch_WhatsYourName::
	.string "Rồi.\n"
	.string "Con tên gì?$"

gText_Birch_SoItsPlayer::
	.string "À, con tên {PLAYER} hả?$"

gText_Birch_YourePlayer::
	.string "Rồi, ô kê!\p"
	.string "Con là {PLAYER} mới chuyển tới\n"
	.string "quê chú, thị trấn MỸ BẠCH, hả?\l"
	.string "Hiểu rồi!\p"
	.string "$"

gText_Birch_AreYouReady::
	.string "Sẵn sàng chưa?\p"
	.string "Cuộc phiêu lưu sắp\n"
	.string "bắt đầu.\p"
	.string "Hãy can đảm bước vào\n"
	.string "thế giới POKéMON, nơi mà ước mơ,\l"
	.string "cuộc thám hiểm, và tình bạn đang đón chờ!\p"
	.string "Thôi, gặp lại sau nha.\n"
	.string "Chút nữa qua PHÒNG THÍ NGHIỆM gặp chú.\p"
	.string "$"
