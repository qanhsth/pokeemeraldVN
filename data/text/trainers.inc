	.string "Có một chỗ kỳ lạ gần đây.\n"
	.string "Ở đó có một toà tháp lớn.\l"
	.string "Sao bạn không tới đó thử?$"

Route131_Text_KevinIntro:
	.string "Con người ở LÀNG NỔI\n"
	.string "rất hiền lành.\p"
	.string "Họ không bao giờ nổi giận.\n"
	.string "Tui cũng vậy đó.$"

Route131_Text_KevinDefeat:
	.string "Ủaaa!$"

Route131_Text_KevinPostBattle:
	.string "Chặc! …Ủa, khoan.\n"
	.string "Tui không có bực. Thiệt!\p"
	.string "Nhưng mà, mạnh quá vậy ba!\n"
	.string "Hahaha!$"

Route132_Text_GilbertIntro:
	.string "Hồi nhỏ tui hay bị cảm lắm,\n"
	.string "nhưng mà kể từ khi tui đi bơi,\l"
	.string "là người tui khoẻ khoắn lên.$"

Route132_Text_GilbertDefeat:
	.string "Tui muốn được khoẻ mạnh hơn…$"

Route132_Text_GilbertPostBattle:
	.string "Mấy NHL đi qua mấy ngọn đồi, núi\n"
	.string "nên là chắc họ cũng khoẻ.$"

Route132_Text_DanaIntro:
	.string "Tui ráng né, không bơi mấy chỗ có\n"
    .string "dòng chảy quá mạnh.$"

Route132_Text_DanaDefeat:
	.string "Ủa, trời, ơi!$"

Route132_Text_DanaPostBattle:
    .string "Nếu bị dòng nước cuốn trôi, tui sẽ\n"
    .string "không cảm được phương hướng…$"

Route132_Text_RonaldIntro:
	.string "Thắng hay thua,\n"
	.string "phải thử mới biết!$"

Route132_Text_RonaldDefeat:
	.string "Oaaaa!\n"
	.string "Chìm trong cái thua!$"

Route132_Text_RonaldPostBattle:
	.string "Tui không giờ đấu trận mà tui biết\n"
	.string "trước kết quả. Tui chỉ thích đấu\l"
	.string "kiểu xém thắng hoặc xém thua!$"

Route132_Text_KiyoIntro:
	.string "Tui ngẫm về POKéMON 24/24.\n"
    .string "Sao mà bạn hạ tui được?$"

Route132_Text_KiyoDefeat:
	.string "Thua.\n"
	.string "Tui thừa nhận là mình thua.$"

Route132_Text_KiyoPostBattle:
	.string "Urggh…\n"
    .string "Bạn là fan cuồng POKéMON mà, đúng không?\p"
    .string "Chắc bạn phải nghĩ về POKéMON 24/24\n"
    .string "mà, phải không?$"

Route132_Text_MakaylaIntro:
	.string "Ta lúc nào cũng ở bên chồng,\n"
	.string "không có ổng, ta không có thắng được.$"

Route132_Text_MakaylaDefeat:
	.string "Ụa, vậy chắc ta không đủ trình.$"

Route132_Text_MakaylaPostBattle:
	.string "Cái cậu trai ở đằng kia nhìn giống\n"
	.string "y như ông chồng ta hồi còn trẻ vậy.\p"
	.string "Làm mình ngại đỏ mặt!$"

Route132_Text_JonathanIntro:
	.string "Có người nhìn chằm chằm tui.\n"
	.string "Là bạn phải không?$"

Route132_Text_JonathanDefeat:
	.string "Chời!\n"
	.string "Mạnh dữ nha!$"

Route132_Text_JonathanPostBattle:
	.string "Sao cứ có cảm giác ai đang\n"
	.string "nhìn mình hoài vậy cà?\p"
	.string "Không tập trung được!$"

Route132_Text_PaxtonIntro:
	.string "Vợ ta đi đâu mất tiêu rồi?\n"
	.string "Ta lúc nào cũng ở cạnh cổ.\l"
	.string "Không biết 1 mình có thắng nổi không nữa.$"

Route132_Text_PaxtonDefeat:
	.string "Vậy là, ta không có tự thắng\n"
	.string "một mình được rồi.$"

Route132_Text_PaxtonPostBattle:
	.string "Chắc vợ ta đang kiếm ta.\n"
	.string "Thôi chắc ta cũng chạy đi kiếm cổ đây.$"

Route132_Text_DarcyIntro:
	.string "Tui thích tập 1 mình ở đây.\n"
	.string "Nhiều người tới quá, khó chịu ghê!$"

Route132_Text_DarcyDefeat:
	.string "Rồi! Ai thích lại thì lại,\n"
	.string "tui không có nói gì nữa đâu.$"

Route132_Text_DarcyPostBattle:
	.string "Đúng ra là tui phải đi chung với ông\n"
	.string "già đó làm một đội để thách đấu.$"

Route133_Text_FranklinIntro:
	.string "Dòng nước cũng đưa bạn tới đây sao?\n"
	.string "Chắc phải là định mệnh rồi.\l"
	.string "Đấu đi!$"

Route133_Text_FranklinDefeat:
	.string "Mạnh!\n"
	.string "Quá trời!$"

Route133_Text_FranklinPostBattle:
	.string "Chắc tại cái vận của tui, kéo NHL\n"
	.string "mạnh cỡ bạn tới đây…\l"
	.string "Chắc tui bị nguyền rồi…$"

Route133_Text_DebraIntro:
    .string "Cuộc đời tui đầy đau khổ và bất hạnh…\n"
    .string "Tui bị ruồng bỏ, và đây chính là nơi\l"
    .string "mà tui bị trôi dạt tới…$"

Route133_Text_DebraDefeat:
    .string "Lại một thất bại nữa…$"

Route133_Text_DebraPostBattle:
    .string "Một cuộc đời trôi dạt…\n"
    .string "Tui không muốn như vậy nữa!$"

Route133_Text_LindaIntro:
	.string "Chào mừng!\n"
	.string "Tui rất mong chờ bạn!$"

Route133_Text_LindaDefeat:
	.string "Đừng mà! Làm ơn đi!$"

Route133_Text_LindaPostBattle:
	.string "NHL con nít mạnh vậy…\n"
	.string "Bực mình!$"

Route133_Text_WarrenIntro:
	.string "Tui muốn được thắng như người ta, mà\n"
	.string "tui không thích nuôi POKéMON giống họ.$"

Route133_Text_WarrenDefeat:
	.string "Chết tiệt!\n"
	.string "Cách làm của mình bị sai rồi!$"

Route133_Text_WarrenPostBattle:
	.string "Sẽ càng vui hơn khi mà tui làm\n"
	.string "theo cách khác với người ta.\l"
	.string "Thì, đơn nhiên là vậy rồi!$"

Route133_Text_BeckIntro:
	.string "Tui đi tới tận đây với\n"
	.string "POKéMON CHIM.$"

Route133_Text_BeckDefeat:
	.string "Bạn…\n"
	.string "Ngầu quá xá!$"

Route133_Text_BeckPostBattle:
	.string "Tui muốn quay về TP.CÂY,\n"
	.string "mà tui cũng dần thích chỗ này rồi.$"

Route133_Text_MollieIntro:
	.string "Ta đấu hơn ngàn trận rồi.\n"
	.string "Tới nỗi quên đếm luôn mà.$"

Route133_Text_MollieDefeat:
	.string "Ta có thể thua hơn ngàn lần,\n"
	.string "nhưng thua vẫn thấy tức.$"

Route133_Text_MolliePostBattle:
	.string "Cứ giữ phong độ đi, nhóc. Rồi ngươi\n"
	.string "sẽ được giống ta và chồng ta thôi.$"

Route133_Text_ConorIntro:
	.string "Tụi trẻ thích hùa theo người ta.\n"
	.string "Tụi nó không có định hướng.$"

Route133_Text_ConorDefeat:
	.string "Con có mục tiêu cho riêng mình đó.$"

Route133_Text_ConorPostBattle:
	.string "Đừng có nghe theo người ta.\n"
	.string "Đừng có mất phương hướng khi lớn lên.$"

Route134_Text_JackIntro:
	.string "Kể mấy con POKéMON biết bơi đi nữa,\n"
	.string "cũng bị dòng chảy cuốn theo mà thôi.$"

Route134_Text_JackDefeat:
	.string "Àidéeeeee!$"

Route134_Text_JackPostBattle:
	.string "Tui nghĩ là POKéMON cũng thích\n"
	.string "dòng chảy nhanh ở vòng khu này.$"

Route134_Text_LaurelIntro:
	.string "Con LUVDISC của tui muốn có\n"
	.string "trận đấu vui vui. Chiều ý nó nha?$"

Route134_Text_LaurelDefeat:
	.string "Ủaụaủa!$"

Route134_Text_LaurelPostBattle:
	.string "Có một nhà sưu tập đang săn lùng\n"
    .string "VẢY của LUVDISC.$"

Route134_Text_AlexIntro:
	.string "Ô kê con dê! Nghỉ vậy đủ rồi bồ!\n"
	.string "Tới giờ đấu rồi!$"

Route134_Text_AlexDefeat:
	.string "Đuối tiếp…$"

Route134_Text_AlexPostBattle:
	.string "POKéMON CHIM của tui rất là\n"
	.string "nhanh đuối sau chuyến bay dài…$"

Route134_Text_HitoshiIntro:
	.string "Bạn là NHL POKéMON.\n"
	.string "Không cần nhiều lời. Đấu luôn đi.$"

Route134_Text_HitoshiDefeat:
	.string "… … … … … …\n"
	.string "… … … … … …$"

Route134_Text_HitoshiPostBattle:
	.string "Tui là người thách đấu bạn, và rồi\n"
	.string "thua luôn. Nhục quá vậy trời…$"

Route134_Text_AaronIntro:
    .string "Sóng dữ dội ở khu này giúp chúng ta\n"
    .string "trở nên mạnh mẽ hơn bao giờ hết.$"

Route134_Text_AaronDefeat:
    .string "Tui thừa nhận thất bại.$"

Route134_Text_AaronPostBattle:
    .string "Tụi tui sẽ quay lại, tiếp tục\n"
    .string "huấn luyện tại THÁC SAO BĂNG.\p"
    .string "Nếu muốn, bạn cũng nên đi theo đi.\n"
    .string "Chắc chắn bạn sẽ trở nên cứng cỏi hơn!$"

Route134_Text_KelvinIntro:
	.string "Th-thuyền của tụi tui!\n"
	.string "Sóng đánh trôi đi mất tiêu!$"

Route134_Text_KelvinDefeat:
	.string "Aoaoaoaoaoaoa!\n"
	.string "Làm ơn, dừng lại đi mà! Làm ơn!$"

Route134_Text_KelvinPostBattle:
	.string "Tụi tui không biết LƯỚT SÓNG, sao\n"
	.string "tụi tui về nhà được giờ?\p"
	.string "Thực ra là, tui biết là POKéMON xỉu cũng\n"
	.string "có thể LƯỚT SÓNG được, mà cứ kỳ sao á.$"

Route134_Text_MarleyIntro:
	.string "POKéMON của bạn có né được đòn\n"
	.string "tia chớp cực nhanh của tụi tui không?$"

Route134_Text_MarleyDefeat:
	.string "Kỹ thuật như vậy mà cũng có sao!\n"
	.string "Mấy bạn đã hoàn toàn hạ gục tụi tui.$"

Route134_Text_MarleyPostBattle:
	.string "Tui vẫn còn đam mê tốc độ lắm.\n"
	.string "Tui sẽ cố gắng hơn.$"

Route134_Text_ReynaIntro:
	.string "POKéMON của tui không có\n"
	.string "dễ ăn đâu!$"

Route134_Text_ReynaDefeat:
	.string "Giỡn mặt hả!\n"
	.string "Nói coi sao tui thua được!$"

Route134_Text_ReynaPostBattle:
	.string "Haha!\n"
	.string "Tui biết rồi, bạn là người thắng!\p"
	.string "Tui sẽ mạnh lên bằng cách\n"
	.string "hạ hết NHL mà tui tình cờ gặp!$"

Route134_Text_HudsonIntro:
	.string "Nói nghe, bạn có gặp\n"
	.string "THUỶ THỦ nào ở đây không?$"

Route134_Text_HudsonDefeat:
	.string "Trời, cũng dữ dằn!$"

Route134_Text_HudsonPostBattle:
	.string "Thuyền của tụi tui bị trôi ra khơi rồi.\p"
	.string "Thằng bạn tui nó nhát lắm, nên là\n"
	.string "tui thấy hơi lo.$"
