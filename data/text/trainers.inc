	.string "rất nhiều khi tiến hoá, lạ ghê!$"

Route115_Text_TimothyIntro:
	.string "Hửm…\n"
	.string "Có vẻ bạn cũng có tài…\l"
	.string "Hãy để tui kiểm tra thử!$"

Route115_Text_TimothyDefeat:
	.string "Bạn còn mạnh hơn\n"
	.string "tui tưởng!$"

Route115_Text_TimothyPostBattle:
	.string "Không có ai sanh ra đã giỏi đâu.\n"
	.string "Tuỳ thuộc vô nỗ lực hết đó!\l"
	.string "Đó là ý kiến của riêng tui…$"

Route115_Text_TimothyRegister:
	.string "Hừm… Thua như vầy sẽ đục\n"
	.string "một lỗ sâu trong ký ức.\p"
	.string "Nếu bạn chịu, tui muốn được\n"
	.string "có cơ hội khác để làm lại.$"

Route115_Text_TimothyRematchIntro:
	.string "Hưm… Như mọi khi, sự lanh lợi\n"
	.string "của bạn đã nói lên tất cả.\l"
	.string "Lại đây, chơi với tui đi!$"

Route115_Text_TimothyRematchDefeat:
	.string "Vẫn mạnh như mọi khi!$"

Route115_Text_TimothyPostRematch:
	.string "Tất cả là do nỗ lực!\p"
	.string "Tui thua là tại tui chưa\n"
	.string "đủ cố gắng!$"

Route115_Text_KoichiIntro:
	.string "Ê!\p"
	.string "MACHOP của ta!\p"
	.string "Yêu cầu ngươi thách đấu!$"

Route115_Text_KoichiDefeat:
	.string "Ây da, ây da, ây da!$"

Route115_Text_KoichiPostBattle:
	.string "Đoàn quân MACHOP của ta!\p"
	.string "Cho tới lúc tụi nó mạnh lên,\n"
	.string "ta cũng sẽ mạnh lên theo!$"

Route115_Text_NobIntro:
	.string "Kỹ năng mạnh nhất của tui là\n"
    .string "lấy đầu đập bể gạch!$"

Route115_Text_NobDefeat:
	.string "Ừgoaaaa!\n"
	.string "Bể đầu rồi!$"

Route115_Text_NobPostBattle:
	.string "Tui có dạy karate cho POKéMON.\p"
	.string "Hình như tụi nó còn giỏi hơn tui\n"
	.string "nữa. Vui sướng ghê.$"

Route115_Text_NobRegister:
	.string "Rất ấn tượng! Hãy cho tui một\n"
	.string "trận tái đấu khi tui luyện tập xong!$"

Route115_Text_NobRematchIntro:
	.string "Kể từ lần bị bạn đánh bại,\n"
	.string "tụi tui đã luyện võ rất nhiều.\l"
	.string "Lại đây cho tui trận tái đấu coi!$"

Route115_Text_NobRematchDefeat:
	.string "Ừgoaaaa!\n"
	.string "Thua nữaaa!$"

Route115_Text_NobPostRematch:
	.string "POKéMON của tui sẽ càng mạnh hơn!\n"
	.string "Tui sẽ gấp đôi huấn luyện cho nó!$"

Route115_Text_CyndyIntro:
	.string "Đây là chỗ luyện tập bí mật của tui!\n"
	.string "Đừng có vô phá!$"

Route115_Text_CyndyDefeat:
	.string "Tui chưa luyện đủ rồi!$"

Route115_Text_CyndyPostBattle:
	.string "Cát giống như một lớp đệm giúp giảm\n"
    .string "độ va chạm và chấn thương.\l"
    .string "Đây là nơi lý tưởng để tập luyện.$"

Route115_Text_CyndyRegister:
	.string "Thôi được, bạn có thể tới đây thoải mái.\n"
	.string "Đổi lại, tui muốn được tái đấu.$"

Route115_Text_CyndyRematchIntro:
	.string "Rồi, vô lẹ đi!$"

Route115_Text_CyndyRematchDefeat:
	.string "Tui đấu được nhưng mà POKéMON của tui…$"

Route115_Text_CyndyPostRematch:
	.string "Cho dù có thua, thì tui\n"
	.string "cũng nhận lại được niềm vui.\l"
	.string "Chắc chắc là tui phải yêu POKéMON rồi.$"

Route115_Text_HectorIntro:
	.string "Tui có POKéMON hiếm nè!\n"
	.string "Bạn muốn coi thử không?$"

Route115_Text_HectorDefeat:
	.string "Bạn…\n"
	.string "Bạn muốn lấy POKéMON của tui phải không?$"

Route115_Text_HectorPostBattle:
	.string "Có con POKéMON hiếm này.\n"
	.string "Vậy là đủ thoã mãn rồi.$"

Route115_Text_KyraIntro:
	.string "Vừa chạy vừa đấu luôn!\n"
	.string "Coi thử coi theo kịp tui không nha!$"

Route115_Text_KyraDefeat:
	.string "Thở, thở…$"

Route115_Text_KyraPostBattle:
	.string "Tui đã lầm khi cố vừa\n"
	.string "chạy vừa thách đấu!\p"
	.string "Chắc phải chạy thêm vòng nữa quá…$"

Route115_Text_JaidenIntro:
	.string "Hãy nhận lấy!\n"
	.string "Đòn tối thượng của nhẫn giả POKéMON!$"

Route115_Text_JaidenDefeat:
	.string "Oaaaaa!\n"
	.string "Chiến thuật của tụi tui thất bại rồi!$"

Route115_Text_JaidenPostBattle:
	.string "Nhưng mà POKéMON của tui cũng mạnh,\n"
	.string "đúng không?$"

Route115_Text_HeleneIntro:
	.string "POKéMON của tui có võ\n"
	.string "cỡ đai đen đó!$"

Route115_Text_HeleneDefeat:
	.string "Nhục quá!$"

Route115_Text_HelenePostBattle:
	.string "Hiếm khi thấy ai\n"
	.string "giỏi hơn mình…\p"
	.string "À, tui biết ời!\n"
	.string "Bạn là CHỦ GYM, phải ôn?$"

Route115_Text_AlixIntro:
	.string "Ánh mắt ta chạm nhau!\n"
	.string "Sao nỡ cách xa nhau được!$"

Route115_Text_AlixDefeat:
	.string "Gặc!\n"
	.string "Cũng ghê đó!$"

Route115_Text_AlixPostBattle:
	.string "Ừ ha.\n"
	.string "Ta HÔ BIẾN về nhà đây.$"

Route115_Text_MarleneIntro:
	.string "Ngươi làm ta phân tâm rồi…\n"
	.string "Chịu phạt đi.$"

Route115_Text_MarleneDefeat:
	.string "Ngươi làm phân tâm ta rồi!$"

Route115_Text_MarlenePostBattle:
	.string "Ta đang thiền với POKéMON.\n"
	.string "Mà nơi này có vẻ không yên tịnh cho lắm…$"

Route116_Text_ClarkIntro:
	.string "Nếu không đi qua hầm được,\n"
	.string "thì tui sẽ leo lên trên luôn.$"

Route116_Text_ClarkDefeat:
	.string "Hổn hển… Hổn hển…\n"
    .string "Thua rồi mệt ghê…$"

Route116_Text_ClarkPostBattle:
	.string "Nếu không có đường hầm cũng không sao.\n"
	.string "Với NGƯỜI ĐI BỘ, núi cũng là đường!$"

Route116_Text_JoeyIntro:
	.string "Luật POKéMON của tui!\n"
	.string "Coi nè!$"

Route116_Text_JoeyDefeat:
	.string "Ây da! Xước da!\n"
	.string "Chắc phải băng lại mới được!$"

Route116_Text_JoeyPostBattle:
	.string "Băng là biểu hiện của sự kiên cường!\n"
	.string "Tui sẽ quấn thêm cái nữa!$"

Route116_Text_JoseIntro:
	.string "POKéMON BỌ của tui mạnh lắm đó!\n"
	.string "Đấu đi!$"

Route116_Text_JoseDefeat:
	.string "Tui thua rồi!\n"
	.string "Tưởng đâu thắng được!$"

Route116_Text_JosePostBattle:
	.string "POKéMON BỌ tiến hoá nhanh.\n"
	.string "Nên là cũng mạnh lên nhanh hơn.$"

Route116_Text_JaniceIntro:
	.string "Để tui cho bạn coi POKéMON\n"
	.string "dễ thương của tui mạnh cỡ nào!$"

Route116_Text_JaniceDefeat:
	.string "Bạn hơn tui 1 bậc rồi…$"

Route116_Text_JanicePostBattle:
	.string "POKéMON mà vừa dễ thương vừa mạnh,\n"
	.string "là lý tưởng đó, tui nghĩ vậy.$"

Route116_Text_JerryIntro:
	.string "Tụi tui học được rất nhiều ở\n"
	.string "TRƯỜNG HUẤN LUYỆN.\p"
	.string "Tui muốn thử sức với những gì đã học!$"

Route116_Text_JerryDefeat:
	.string "Tui làm biếng học quá…\n"
	.string "Bởi vậy mới thua.$"

Route116_Text_JerryPostBattle:
	.string "Chắc tui phải đi học phụ đạo thêm\n"
	.string "ở TRƯỜNG HUẤN LUYỆN mới được.\l"
	.string "Không là LỚP TRƯỞNG giận tui á.$"

Route116_Text_JerryRegister1:
	.string "Tui được học ở TRƯỜNG HUẤN LUYỆN\n"
	.string "là BẢN ĐỒ có thể lưu số NHL khác.\p"
	.string "Tui không hiểu vậy là sao,\n"
	.string "nên là cho tui thử cái nha?$"

Route116_Text_JerryRegister2:
	.string "Tui được học ở TRƯỜNG HUẤN LUYỆN\n"
	.string "là BẢN ĐỒ có thể lưu số NHL khác.\p"
	.string "Tui không hiểu vậy là sao,\n"
	.string "nên là cho tui thử cái nha?$"

Route116_Text_JerryRematchIntro:
	.string "Bữa giờ tui học rất nghiêm túc ở\n"
	.string "TRƯỜNG HUẤN LUYỆN.\l"
	.string "Tui sẽ không thua như lần trước đâu.$"

Route116_Text_JerryRematchDefeat:
	.string "Hử?\n"
	.string "Tui học đàng hoàng lắm mà trời.$"

Route116_Text_JerryPostRematch:
	.string "Chắc tui phải đi học phụ đạo thêm\n"
	.string "ở TRƯỜNG HUẤN LUYỆN mới được.\l"
	.string "Không là LỚP TRƯỞNG giận tui.$"

Route116_Text_KarenIntro:
	.string "Tui học ở trên trường với\n"
	.string "trên đường về nữa!$"

Route116_Text_KarenDefeat:
	.string "Sốc quá--Thua rồi sao?$"

Route116_Text_KarenPostBattle:
	.string "Ọoỏo, tui sẽ không trang nhã giống\n"
	.string "LỚP TRƯỞNG được nếu cứ như vầy!$"

Route116_Text_KarenRegister1:
	.string "Ủa, ê! Cái đó là BẢN ĐỒ phải không?\n"
	.string "Tui cũng có 1 cái nè! Lưu số tui với!$"

Route116_Text_KarenRegister2:
	.string "Ủa, ê! Cái đó là BẢN ĐỒ phải không?\n"
	.string "Tui cũng có 1 cái nè! Lưu số tui với!$"

Route116_Text_KarenRematchIntro:
	.string "Tui học được rất nhiều từ lúc thấy bạn.\n"
	.string "Bạn phải coi công sức của tui nè!$"

Route116_Text_KarenRematchDefeat:
	.string "Sốc tập 2.\n"
	.string "Thua nữa hả?$"

Route116_Text_KarenPostRematch:
	.string "Bạn hạ được LỚP TRƯỞNG rồi hả?\n"
	.string "Vậy, tui chưa hạ được bạn rồi. Chưa được.$"

Route116_Text_SarahIntro:
	.string "Nói cho bạn biết, tui chưa\n"
	.string "bao giờ thua ai cái gì hết.$"

Route116_Text_SarahDefeat:
	.string "Ôi trời đất ơi.\n"
	.string "Cái này hơi mới với tui á nghen.$"

Route116_Text_SarahPostBattle:
	.string "Cuộc sống xa hoa đã cho tui\n"
	.string "gần như tất cả những gì mình muốn.\p"
	.string "Tuy nhiên, nếu nói về POKéMON,\n"
	.string "giàu có cũng không có nghĩa lý gì.$"

Route116_Text_DawsonIntro:
	.string "Khi bạn lỡ để mắt tới bộ lông quyến rũ\n"
	.string "của POKéMON của tui, sức hút của nó\l"
	.string "sẽ làm cho bạn không thể cưỡng lại!$"

Route116_Text_DawsonDefeat:
	.string "Trời, ơi, đừng có vậy mà!$"

Route116_Text_DawsonPostBattle:
	.string "Thôi, thôi, thôi má!\n"
	.string "Bạn làm xù bộ lông của POKéMON tui rồi!\l"
	.string "Bạn còn phá kiểu tóc của tui luôn!\l"
	.string "Làm tui phải đi lại gặp nhà tạo kiểu!$"

Route116_Text_DevanIntro:
	.string "Ta sẽ chiến hết mình!$"

Route116_Text_DevanDefeat:
	.string "Aiyiyi!\n"
	.string "Không còn gì để bàn!$"

Route116_Text_DevanPostBattle:
	.string "Chắc tui phải chơi POKéMON\n"
	.string "hệ khác thôi, chắc phải vậy thôi.$"

Route116_Text_JohnsonIntro:
	.string "Hết đường đi rồi.\n"
	.string "Chán quá, thách đấu cho vui nha?$"

Route116_Text_JohnsonDefeat:
	.string "Thua nhưng mà cũng vui đó.$"

Route116_Text_JohnsonPostBattle:
	.string "Ở lại đây\n"
	.string "với tui đi?$"

Route117_Text_IsaacIntro:
	.string "Nghe nè, tui có thể thách đấu với\n"
	.string "bạn bằng POKéMON tui đang nuôi không?$"

Route117_Text_IsaacDefeat:
	.string "Bạn nuôi POKéMON kỹ ghê…$"

Route117_Text_IsaacPostBattle:
	.string "POKéMON không chỉ có sức mạnh.\p"
	.string "Trau dồi một khía cạnh độc đáo trong\n"
    .string "tính cách của bản thân cũng là một cách\l"
    .string "để tận hưởng POKéMON.$"

Route117_Text_IsaacRegister:
	.string "Tui sẽ huấn luyện nhiều hơn gấp đôi.\n"
	.string "Bạn sẽ lại tới thăm tụi tui chứ?$"

Route117_Text_IsaacRematchIntro:
	.string "POKéMON được tui nuôi bữa giờ\n"
	.string "cũng lớn lên nhiều như trước rồi.$"

Route117_Text_IsaacRematchDefeat:
	.string "Vậy là bạn biết cách nuôi tụi nó rồi.\n"
	.string "Chắc bạn cũng có kỹ năng chăm con…$"

Route117_Text_IsaacPostRematch:
	.string "POKéMON đang lớn tốt!\n"
	.string "Bạn nên cho nó đi THI đi.$"

Route117_Text_LydiaIntro:
	.string "Xin hãy cho phép tôi nhận xét\n"
	.string "cách mà bạn nuôi POKéMON.$"

Route117_Text_LydiaDefeat:
	.string "Tụi nó đã được nuôi đúng cách.$"

Route117_Text_LydiaPostBattle:
	.string "Hãy thử chú ý vô\n"
	.string "tính cách của POKéMON.$"

Route117_Text_LydiaRegister:
	.string "Tôi rất vui khi được gặp NHL\n"
    .string "giỏi như bạn. Hy vọng được gặp lại bạn.$"

Route117_Text_LydiaRematchIntro:
	.string "Cho phép tôi nhận xét cách mà\n"
	.string "bạn nuôi POKéMON.$"

Route117_Text_LydiaRematchDefeat:
	.string "Tụi nó lớn quá trời rồi.$"

Route117_Text_LydiaPostRematch:
	.string "POKéMON có vẻ thích nhiều loại\n"
	.string "{POKEBLOCK}, tuỳ theo tánh cách.$"

Route117_Text_DylanIntro:
	.string "Tui đang thi 3 môn phối hợp, mà\n"
	.string "kệ đi, thách đấu nè!$"

Route117_Text_DylanDefeat:
	.string "Tui cạn kiệt năng lượng rồi!$"

Route117_Text_DylanPostBattle:
    .string "Thôi xong rồi…\p"
    .string "Hình như tui bị tụt xuống\n"
    .string "chót bảng trong lúc đấu rồi…$"

Route117_Text_DylanRegister:
    .string "POKéMON cũng phải mạnh sao?\n"
	.string "Tui muốn bạn huấn luyện cho tui!$"

Route117_Text_DylanRematchIntro:
    .string "Tui đang thi 3 môn phối hợp,\n"
    .string "nhưng tui vẫn đang dẫn đầu.\l"
    .string "Đánh nhanh nha!$"

Route117_Text_DylanRematchDefeat:
	.string "Tui hết năng lượng nữa rồi!$"

Route117_Text_DylanPostRematch:
	.string "Tui đứng đầu môn bơi với đạp xe,\n"
	.string "mà chưa có tự tin vô bộ môn\l"
	.string "thách đấu POKéMON.$"

Route117_Text_MariaIntro:
	.string "Tui luyện tập thể thao với POKéMON,\n"
	.string "nên là tui rất tự tin về tốc độ của mình.$"

Route117_Text_MariaDefeat:
	.string "Chắc tui cần phải luyện thêm,\n"
	.string "chắc phải vậy rồi.$"

Route117_Text_MariaPostBattle:
	.string "Tập luyện chỉ có nghĩa khi\n"
	.string "bạn tập điều độ mỗi ngày.\p"
	.string "Được rồi! Tui sẽ tập luyện tiếp!\n"
	.string "Mai nha!$"

Route117_Text_MariaRegister:
	.string "Bạn cũng tập nhiều rồi…\n"
	.string "Nếu muốn, tui sẽ đấu với bạn sau!$"

Route117_Text_MariaRematchIntro:
	.string "Dạo này bạn có tập tành gì không?\n"
	.string "Tui thì chắc chắc là có rồi!\l"
	.string "Bằng chứng đây!$"

Route117_Text_MariaRematchDefeat:
	.string "Chắc tui cần phải luyện thêm,\n"
	.string "chắc phải vậy rồi.$"

Route117_Text_MariaPostRematch:
	.string "Mai tui sẽ tập tiếp.\n"
	.string "Khi nào rảnh, đấu lại nha!$"

Route117_Text_DerekIntro:
	.string "Từng là NGƯỜI BẮT SÂU!\n"
	.string "Giờ thành NGƯỜI MÊ SÂU luôn rồi!\p"
	.string "Nhưng mà tình yêu cho POKéMON\n"
	.string "vẫn không đổi thay!$"

Route117_Text_DerekDefeat:
	.string "Sự vụng về của tui vẫn\n"
    .string "không thay đổi…$"

Route117_Text_DerekPostBattle:
	.string "Những gì tui làm là nghe theo con tim,\n"
	.string "xong người ta kêu tui là NGƯỜI MÊ SÂU…\p"
	.string "Mà, tui vẫn là chuyên gia về POKéMON BỌ,\n"
	.string "cho nên dĩ nhiên người ta kêu tui là\l"
	.string "NGƯỜI MÊ SÂU.$"

Route117_Text_AnnaIntro:
	.string "AN: Tui chơi với đàn em dễ thương\n"
	.string "lớp dưới. Tui phải làm tốt mới được!$"

Route117_Text_AnnaDefeat:
	.string "AN: Tui đang chơi với đàn em dễ\n"
	.string "thương lớp dưới mà! Cho tui thắng đi!$"

Route117_Text_AnnaPostBattle:
	.string "AN: POKéMON của bạn\n"
