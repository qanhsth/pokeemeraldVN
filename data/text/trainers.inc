Route102_Text_CalvinIntro:
	.string "Nếu bạn có POKéMON rồi, thì bạn\n"
	.string "đã chính thức là NHL POKéMON!\l"
	.string "Bạn không được từ chối thách đấu tui!$"

Route102_Text_CalvinDefeated:
	.string "Arrgh, thua rồi…\n"
	.string "Phải chi luyện tập nhiều hơn…$"

Route102_Text_CalvinPostBattle:
	.string "Nói nghe nè. Nếu mà mạnh như vậy,\n"
	.string "thì bạn phải nói cho tui biết trước chứ!$"

Route102_Text_CalvinRegister:
	.string "Từ lúc tui gặp bạn tới giờ là\n"
	.string "tui luyện nhiều lắm rồi.\p"
	.string "Tui muốn đấu lại với bạn,\n"
	.string "nên là lưu số tui nha?$"

Route102_Text_CalvinRegisterShort:
	.string "Tui muốn đấu lại với bạn,\n"
	.string "nên là lưu số tui nha?$"

Route102_Text_CalvinRematchIntro:
	.string "Kể từ lúc thua bạn, tui đã\n"
	.string "luyện cấp cho POKéMON rất nhiều.\l"
	.string "Bạn không được từ chối thách đấu tui!$"

Route102_Text_CalvinRematchDefeated:
	.string "Arrgh, thua rồi…\n"
	.string "Phương pháp huấn luyện bị sai hả ta?$"

Route102_Text_CalvinRematchPostBattle:
	.string "Nếu mà bạn mạnh hơn nữa,\n"
	.string "thì tui sẽ càng mạnh hơn.$"

Route102_Text_AllenIntro:
	.string "Bạn mới là NHL hả?\n"
	.string "Vậy tụi mình là tân binh rồi!$"

Route102_Text_AllenDefeated:
	.string "Tui kêu bạn lại tại tui tưởng\n"
	.string "là tui có thể thắng bạn…$"

Route102_Text_AllenPostBattle:
	.string "Tui chưa thắng được một lần…\n"
	.string "Hy vọng sẽ sớm được…$"

Route102_Text_RickIntro:
	.string "Hahah! Ánh mắt ta chạm nhau rồi!\n"
	.string "Ta sẽ hạ gục ngươi bằng POKéMON hệ BỌ!$"

Route102_Text_RickDefeated:
	.string "Ây da! Thua thì thôi!$"

Route102_Text_RickPostBattle:
	.string "Nếu ngươi khoá mắt với NHL,\n"
	.string "ngươi sẽ phải thách đấu! Đó là luật!$"

Route102_Text_TianaIntro:
	.string "Tui sẽ tiếp tục thắng và\n"
	.string "trở thành NHL giỏi nhất.\p"
	.string "Hãy giúp sự nghiệp tui tiến xa hơn!$"

Route102_Text_TianaDefeated:
	.string "Vậy là tui giúp bạn tiến xa hơn rồi…$"

Route102_Text_TianaPostBattle:
	.string "Để dành được chiến thắng, tui thấy\n"
	.string "là tui phải bắt nhiều POKéMON hơn.$"

Route103_Text_DaisyIntro:
	.string "Bạn có cảm nhận được hương thơm\n"
	.string "làm xoa dịu tâm hồn không?$"

Route103_Text_DaisyDefeated:
	.string "Bạn không bị mùi hương làm lạc lối…$"

Route103_Text_DaisyPostBattle:
    .string "Liệu pháp hương thơm là một hình thức\n"
    .string "chữa lành tâm hồn bằng mùi hương.$"

Route103_Text_AmyIntro:
	.string "MY: Tui là MY.\n"
	.string "Còn đây là LY, em gái tui.\l"
	.string "Tụi tui đấu chung với nhau!$"

Route103_Text_AmyDefeated:
	.string "MY: Ủa, thua rồi.$"

Route103_Text_AmyPostBattle:
	.string "MY: Bạn phải ngẫm nghĩ rất nhiều\n"
	.string "khi mà bạn muốn thách đấu với\l"
	.string "2 NHL.$"

Route103_Text_AmyNotEnoughPokemon:
	.string "MY: Ủa, bạn có 1\n"
	.string "POKéMON thôi sao.\l"
	.string "Vậy hong có đấu được đâu.$"

Route103_Text_LivIntro:
	.string "LY: Tụi tui đấu chung\n"
	.string "một đội.$"

Route103_Text_LivDefeated:
	.string "LY: Trời ơi, mình thua rồi chị 2 ơi…$"

Route103_Text_LivPostBattle:
	.string "LY: Tui với chị 2,\n"
	.string "phối hợp với nhau rất ăn ý…\p"
	.string "Vậy mà vẫn thua…$"

Route103_Text_AmyLivRegister:
	.string "LY: Thực ra, tụi tui mạnh lắm đó…\n"
	.string "Thiệt mà! Lần sau gặp nhau là biết!$"

Route103_Text_LivNotEnoughPokemon:
	.string "LY: Nếu muốn thách đấu tụi tui,\n"
	.string "thì bạn phải có 2 con POKéMON!\l"
	.string "Không thì không có công bằng đâu!$"

Route103_Text_AmyRematchIntro:
	.string "MY: Tui là MY nè.\n"
	.string "Còn đây là LY, em gái tui.\l"
	.string "Tụi tui chung team!$"

Route103_Text_AmyRematchDefeated:
	.string "MY: Aww, boo!\n"
	.string "Không thắng được luôn…$"

Route103_Text_AmyRematchPostBattle:
	.string "MY: Bạn phải ngẫm nghĩ rất nhiều\n"
	.string "khi mà bạn muốn thách đấu với\l"
	.string "2 NHL.$"

Route103_Text_AmyRematchNotEnoughPokemon:
	.string "MY: Ủa, bạn có 1\n"
	.string "POKéMON thôi sao.\l"
	.string "Vậy hong có đấu được đâu.$"

Route103_Text_LivRematchIntro:
	.string "LY: Tụi tui làm 1 đội\n"
	.string "đấu chung với nhau.$"

Route103_Text_LivRematchDefeated:
	.string "LY: Awww, thua nữa rồi…\n"
	.string "Chị 2 ơi…$"

Route103_Text_LivRematchPostBattle:
	.string "LY: Tui với chị 2,\n"
	.string "phối hợp rất ăn ý…\p"
	.string "Mà sao thua nữa được?$"

Route103_Text_LivRematchNotEnoughPokemon:
	.string "LY: Nếu muốn thách đấu tụi tui,\n"
	.string "thì bạn phải có 2 con POKéMON!\l"
	.string "Không thì không có công bằng đâu!$"

Route103_Text_AndrewIntro:
	.string "Gah! Dây câu rối tùm lum!\n"
	.string "Tui đang bực bội quá nè!\l"
	.string "Thôi! Thách đấu đi!$"

Route103_Text_AndrewDefeated:
	.string "Gah! Thua rồi!\n"
	.string "Bực mình quá!$"

Route103_Text_AndrewPostBattle:
	.string "Gah, bực quá đi…\n"
	.string "Grrrrr…$"

Route103_Text_MiguelIntro:
	.string "POKéMON tui nhìn cưng quá trời!\n"
	.string "Lại đây nựng đi--Đừng có ngại!$"

Route103_Text_MiguelDefeated:
	.string "Trời đất ơi!\n"
	.string "POKéMON đáng yêu của tui!$"

Route103_Text_MiguelPostBattle:
	.string "POKéMON vẫn dế thương\n"
	.string "dù cho có nằm xuống đi nữa!$"

Route103_Text_MiguelRegister:
	.string "Tui sẽ làm bạn phải đi kiếm tui\n"
	.string "để ngắm POKéMON dễ thương của tui!$"

Route103_Text_MiguelRematchIntro:
	.string "Ê, chào bạn! POKéMON dễ thương của tui\n"
	.string "nay còn dễ thương hơn nữa đó!$"

Route103_Text_MiguelRematchDefeated:
	.string "Ủa!\n"
	.string "POKéMON yêu dấu ơi!$"

Route103_Text_MiguelRematchPostBattle:
	.string "Càng dành thời gian chăm sóc,\n"
	.string "POKéMON nó càng thấy cưng hơn.$"

Route103_Text_PeteIntro:
	.string "Cự ly này…\n"
	.string "Bơi qua đại đi!$"

Route103_Text_PeteDefeated:
	.string "Ồ, cũng ghê đó!$"

Route103_Text_PetePostBattle:
	.string "Giờ thì tui biết\n"
	.string "bạn tới từ đâu rồi.\p"
	.string "Nếu tui có POKéMON đáng tin như vậy,\n"
	.string "tui cũng muốn LƯỚT SÓNG trên người nó!$"

Route103_Text_IsabelleIntro:
	.string "Không thấy đường hả?\n"
	.string "Sắp đụng người ta tới nơi rồi!$"

Route103_Text_IsabelleDefeated:
	.string "Trời ơi…$"

Route103_Text_IsabellePostBattle:
	.string "Tui hong có biết bơi nên đang tập nè…\n"
	.string "Xin lỗi nha, xém xíu nữa đụng bạn rồi.$"

Route103_Text_RhettIntro:
	.string "Trời!\n"
	.string "Sao chui vô đây được hay vậy?$"

Route103_Text_RhettDefeated:
	.string "Trời!\n"
	.string "Dữ quá!$"

Route103_Text_RhettPostBattle:
	.string "Bạn có khoái mấy chỗ\n"
	.string "chật chật giống vầy không?$"

Route103_Text_MarcosIntro:
	.string "Có phải tiếng đàn của tôi kéo bạn lại?$"

Route103_Text_MarcosDefeated:
	.string "Buổi biểu diễn của tui…$"

Route103_Text_MarcosPostBattle:
	.string "Tui đang chơi đàn guitar\n"
	.string "ở chỗ ít người, mà cũng có\l"
	.string "nhiều fan tới ủng hộ lắm.\p"
	.string "Heh, chắc tui phải lên chuyên nghiệp thôi.$"

Route104_Text_GinaIntro:
	.string "LY: Được rồi, thách\n"
	.string "đấu POKéMON với tụi tui đi!$"

Route104_Text_GinaDefeat:
	.string "LY: Thua khó chịu ghê!$"

Route104_Text_GinaPostBattle:
	.string "LY: Bạn mạnh đó!\n"
	.string "Tụi tui phải tập luyện nhiều hơn nữa!$"

Route104_Text_GinaNotEnoughMons:
	.string "LY: Ủa? Có 1 con POKéMON thôi hả?\n"
	.string "Vậy tụi tui không đấu với bạn đâu.\p"
	.string "Nếu chỉ có 1 POKéMON, thì nó sẽ\n"
	.string "tủi thân lắm. Vậy không có được đâu.$"

Route104_Text_MiaIntro:
	.string "MY: Tụi tui là 2 chị em\n"
	.string "sinh đôi, đấu chung với nhau.$"

Route104_Text_MiaDefeat:
	.string "MY: Đấu chung nhưng mà lúc nào\n"
	.string "cũng thua hết á…$"

Route104_Text_MiaPostBattle:
	.string "MY: Chị em tui sẽ luyện cấp\n"
	.string "POKéMON để mạnh được như bạn.$"

Route104_Text_MiaNotEnoughMons:
	.string "MY: Bạn muốn thách đấu tụi tui hả?\p"
	.string "Bạn không có 2 POKéMON, đánh\n"
	.string "không có lại đâu.\l"
	.string "Tụi tui mạnh lắm đó!$"

Route104_Text_IvanIntro:
	.string "Sao phải giấu?\n"
	.string "Tui là chuyên gia POKéMON hệ NƯỚC!\p"
	.string "Hả?\n"
	.string "Bạn không biết sao?$"

Route104_Text_IvanDefeat:
	.string "Tui cứ nghĩ là mình cũng không dở,\n"
	.string "mà không phải rồi… Bleah…$"

Route104_Text_IvanPostBattle:
	.string "Tui tập trung câu cá nhiều quá.\n"
	.string "Quên luyện cấp POKéMON luôn…$"

Route104_Text_BillyIntro:
	.string "Để lại dấu chưn trên cát\n"
	.string "vui ghê!$"

Route104_Text_BillyDefeat:
	.string "Waah! Cát rớt vô giày rồi!\n"
	.string "Cát không à!$"

Route104_Text_BillyPostBattle:
	.string "Tui muốn để lại dấu chưn lên\n"
	.string "hết mặt cát, nhưng mà nó\l"
	.string "biến mất nhanh quá…$"

Route104_Text_HaleyIntro:
	.string "Có nên…\n"
	.string "Hay là không?\p"
	.string "Mà thôi cứ đấu đại đi!$"

Route104_Text_HaleyDefeat:
	.string "Biết vậy khỏi đấu cho rồi…$"

Route104_Text_HaleyPostBattle:
	.string "Nếu bạn do dự trước lựa chọn của mình\n"
	.string "rồi để người ta chọn giùm bạn,\l"
	.string "thì bạn sẽ hối hận rằng\l"
	.string "tại sao mọi chuyện lại thành ra như vậy.$"

Route104_Text_HaleyRegister1:
	.string "Bạn cũng mạnh đó, nhưng mà\n"
	.string "tui có nên lưu số bạn không?\l"
	.string "Chắc không đâu ha…\p"
	.string "Mà thôi, tui sẽ lưu số bạn luôn!$"

Route104_Text_HaleyRegister2:
	.string "Bạn cũng mạnh đó, mà hong biết có\n"
	.string "nên lưu số bạn không nữa?\l"
	.string "Mà chắc thôi…\p"
	.string "Mà thôi lưu luôn đi!$"

Route104_Text_HaleyRematchIntro:
	.string "Lại đây, chơi với tui nè!$"

Route104_Text_HaleyRematchDefeat:
	.string "Ohh…\n"
	.string "Tưởng đâu thắng được…$"

Route104_Text_HaleyPostRematch:
	.string "Tại tui muốn thách đấu, nên là\n"
	.string "tui có thể dễ dàng chấp nhận thua cuộc.\p"
	.string "Nhưng mà thua thì vẫn buồn!$"

Route104_Text_WinstonIntro:
	.string "Được thôi, tui chấp nhận thử thách.\n"
	.string "Tui có nhiều tiền lắm.$"

Route104_Text_WinstonDefeat:
	.string "Sao tui không thắng được vậy nè?$"

Route104_Text_WinstonPostBattle:
	.string "Có những thứ mà tiền không mua được.\n"
	.string "Đó là POKéMON…$"

Route104_Text_WinstonRegister1:
	.string "Hửm?\n"
	.string "À, bạn có BẢN ĐỒ rồi ha.\p"
	.string "Tui sẽ lưu số bạn vô.\n"
	.string "Bởi vì là tui có nhiều tiền lắm.$"

Route104_Text_WinstonRegister2:
	.string "Hửm?\n"
	.string "À, bạn có BẢN ĐỒ rồi ha.\p"
	.string "Tui sẽ lưu số bạn vô.\n"
	.string "Bởi vì là tui có nhiều tiền lắm.$"

Route104_Text_WinstonRematchIntro:
	.string "Sau khi thua, tui đã nghiên cứu\n"
	.string "rất nhiều về POKéMON.$"

Route104_Text_WinstonRematchDefeat:
	.string "Tui thua nữa hả?\n"
	.string "Sao không thắng được vậy trời?$"

Route104_Text_WinstonPostRematch:
	.string "Tui rất là giàu, mà sao không\n"
	.string "có thắng được vậy nè…\p"
	.string "Thế giới POKéMON, rộng quá…$"

Route104_Text_CindyIntro:
	.string "Định mệnh làm ta gặp nhau.\n"
	.string "Tui có thể thách đấu bạn không?$"

Route104_Text_CindyDefeat:
	.string "Trời ơi!$"

Route104_Text_CindyPostBattle:
	.string "“Xin chào” là khởi đầu của “tạm biệt.”\n"
	.string "Hy vọng được gặp lại bạn.$"

Route104_Text_CindyRegister1:
	.string "Xin chào, tụi mình lại gặp nhau rồi.\p"
	.string "Chắc là cái duyên rồi.\n"
	.string "Thôi tụi mình lưu số vô BẢN ĐỒ nha.$"

Route104_Text_CindyRegister2:
	.string "Chắc là tụi mình phải nên ghi nhớ\n"
	.string "cách mà tụi mình thu hút lẫn nhau.\p"
	.string "Thôi tụi mình lưu số nhau vô\n"
	.string "BẢN ĐỒ nha.$"

Route104_Text_CindyRematchIntro:
	.string "Xin chào, tụi mình gặp nhau nữa rồi.\n"
	.string "Tui có thể thách đấu bạn không?$"

Route104_Text_CindyRematchDefeat:
	.string "Trời ơi…\n"
	.string "Cố gắng lắm rồi…$"

Route104_Text_CindyPostRematch:
	.string "“Xin chào” là khởi đầu của “tạm biệt.”\n"
	.string "Hy vọng được gặp lại bạn.$"

Route104_Text_DarianIntro:
	.string "Tui bắt được POKéMON nhìn mạnh lắm!\p"
	.string "Nó có một sức hút kỳ diệu!\n"
    .string "Nhìn rất cứng cáp, đúng vậy!$"

Route104_Text_DarianDefeat:
	.string "Chết rồi…$"

Route104_Text_DarianPostBattle:
	.string "Ê, MAGIKARP, không xứng đáng với\n"
	.string "cái tên mày cho lắm, đúng không?$"

Route105_Text_FosterIntro:
	.string "Lẽ ra vòng vòng khu này\n"
	.string "phải có cục đá ma thuật chứ.\l"
	.string "Bạn có biết gì về nó không?$"

Route105_Text_FosterDefeated:
	.string "Tui suy nghĩ về đá nhiều quá,\n"
	.string "trong khi POKéMON vẫn còn yếu…$"

Route105_Text_FosterPostBattle:
	.string "Tui có thể dành hàng giờ để ngắm\n"
	.string "một hòn đá đẹp mà không biết mệt.$"

Route105_Text_LuisIntro:
	.string "Phù! Cứ lo là có đứa nhóc sắp\n"
	.string "chết đuối khi mới nhìn thấy em.\p"
	.string "Nhìn em vẫn ổn mà, vậy em nghĩ\n"
	.string "sao về một trận đấu?$"

Route105_Text_LuisDefeated:
	.string "Ộc ộc… Ộc ộc…$"

Route105_Text_LuisPostBattle:
	.string "Nếu mà bị đuối nước, hãy ra dấu\n"
	.string "hiệu bằng cách quơ tay về trước.$"

Route105_Text_DominikIntro:
	.string "Bơi trong bờ biển xanh thẫm…\n"
	.string "Là sướng nhất!$"

Route105_Text_DominikDefeated:
	.string "Tui thua rồi…\n"
	.string "Buồn như màu xanh nước biển…$"

Route105_Text_DominikPostBattle:
	.string "Sao biển lại có màu xanh?\p"
	.string "Tui có học được ở BẢO TÀNG\n"
	.string "TP.CẢNG, mà giờ quên rồi.$"

Route105_Text_BeverlyIntro:
	.string "Cơ thể tui nhẹ hơn trong nước.\n"
	.string "Cảm giác như mình thon lại vậy!$"

Route105_Text_BeverlyDefeated:
	.string "Nổi lềnh bềnh…$"

Route105_Text_BeverlyPostBattle:
	.string "Cân nặng của mình giảm xuống\n"
	.string "chỉ còn 1/10 khi ở trong nước.\p"
	.string "Như vậy là tui…\n"
	.string "Ụaủa! Xém xíu nói ra cân nặng rồi!$"

Route105_Text_ImaniIntro:
	.string "Bầu trời xanh xanh…\n"
	.string "Biển cả rộng lớn…\l"
	.string "Yên bình quá…$"

Route105_Text_ImaniDefeated:
	.string "Thua trong lúc đang thảnh thơi!$"

Route105_Text_ImaniPostBattle:
	.string "Tui muốn được người ta nói\n"
