	end

Route113_GlassWorkshop_EventScript_NinjaBoy::
	msgbox Route113_GlassWorkshop_Text_FunToBlowGlassFlute, MSGBOX_NPC
	end

Route113_GlassWorkshop_Text_GoCollectAshWithThis:
	.string "Khu vực này toàn là tro núi lửa,\n"
	.string "hù phù!\p"
	.string "Ta được trời ban năng lực, hù phù.\p"
    .string "Ta làm thủy tinh từ tro núi lửa\n"
    .string "và chế tạo vật phẩm, hù phù.\p"
    .string "Lấy cái này đi gom tro đi, hù phù.$"

