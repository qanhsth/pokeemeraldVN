Route104_Text_BrineyLivesInSeasideCottage:
	.string "Ngôi nhà nhỏ bên bờ biển đó\n"
    .string "chính là nơi ÔNG THU đang sống.\p"
    .string "Ông từng là một thuỷ thủ dũng cảm, người\n"
    .string "chưa bao giờ sợ biển, hay giông bão.$"

Route104_Text_WhatsItLikeAtBottomOfSea:
	.string "Biển à?\p"
	.string "Tui tự hỏi ở dưới đáy\n"
	.string "biển có những gì?$"

Route104_Text_ThrowBallAtWeakenedPokemon:
	.string "Nếu muốn chọi CẦU POKéMON,\n"
	.string "trước tiên phải làm mềm POKéMON.\p"
	.string "Sẽ dễ bắt hơn nếu nó bị hạ độc,\n"
	.string "phỏng, hoặc chìm vào giấc ngủ sâu.$"

Route104_Text_OnlyThrowBallAtWildPokemon:
	.string "Nếu bạn chọi CẦU vô POKéMON người ta,\n"
	.string "thì bạn là đồ ăn cướp có biết chưa?\p"
	.string "Chỉ nên chọi cầu POKéMON\n"
	.string "vô POKéMON hoang mà thôi.$"

Route104_Text_ImNotATrainer:
	.string "Không, không phải, tui không phải NHL.\p"
	.string "À mà, nếu NHL đá mắt với bạn, thì chắc\n"
	.string "chắn người ta muốn thách đấu bạn đó.\p"
	.string "Nếu không muốn đấu, thì hãy\n"
	.string "rời xa tầm mắt của họ.$"

Route104_Text_LikeFillingMouthWithSeedsTakeThis:
	.string "Tui thích ngậm 1 đống hạt trong họng,\n"
	.string "xong rồi phun ra phèo phèo đã lắm!\p"
	.string "Cho bạn nè, lấy thử đi!\p"
	.string "Xài lên POKéMON, để cho nó học\n"
	.string "chiêu thức phun hạt ra phèo phèo.$"

Route104_Text_TMsAreOneTimeUse:
	.string "Đây chỉ là lời khuyên thôi!\p"
	.string "Cái TM, MÁY HỌC CHIÊU, chỉ\n"
	.string "xài được có 1 lần thôi.\p"
	.string "Xài 1 lần rồi là hết.\n"
	.string "Nên là suy nghĩ cho kỹ trước khi xài.$"

Route104_Text_DontNeedThisTakeIt:
	.string "TIỆM BÁN BÔNG này mới bán cây\n"
	.string "non gần đây thôi.\p"
	.string "Thấy vui quá nên là\n"
	.string "tui mua tùm lum luôn.\p"
	.string "Tui hong cần cái BẠCH DƯỢC này nữa đâu.\n"
	.string "Lấy giùm tui đi nha?$"

Route104_Text_FlowerShopSellingSaplings:
	.string "TIỆM BÁN BÔNG này mới bán cây\n"
	.string "non gần đây thôi.\p"
	.string "Thấy vui quá nên là tui mua quá\n"
	.string "trời. Giờ hong biết để đâu nữa?$"

Route104_Text_MrBrineysCottage:
	.string "NHÀ CỦA ÔNG THU$"

Route104_Text_RouteSignPetalburg:
	.string "ĐƯỜNG 1O4\n"
	.string "{RIGHT_ARROW} TP.HOA CAM$"

Route104_Text_RouteSignRustboro:
	.string "ĐƯỜNG 1O4\n"
	.string "{UP_ARROW} TP.KIM THÁN$"

Route104_Text_PrettyPetalFlowShop:
	.string "TIỆM BÁN BÔNG ĐẸP$"

Route104_Text_TrainerTipsDoubleBattles:
	.string "MẸO cho các NHL\p"
	.string "Ở vùng HOENN hay có cặp NHL\n"
	.string "đi chung để đấu POKéMON dạng\l"
	.string "2v2, cái này người ta kêu là\l"
	.string "ĐẤU CẶP.\p"
	.string "Trong trận ĐẤU CẶP, NHL phải cho\n"
	.string "2 POKéMON ra sân, 1 con nằm ở đầu\l"
	.string "danh sách và 1 con nằm ở kế bên.\l"
	.string "Nhớ xếp cặp đấu POKéMON cho kỹ.$"

Route104_Text_MayWeShouldRegister:
	.string "PHƯƠNG: Ủa, chao xìn, {PLAYER}!\p"
	.string "Công ty DEVON nâng cấp BẢN ĐỒ với\n"
	.string "chức năng GỌI ĐIỆN rồi phải hong?\p"
	.string "Vậy tụi mình lưu số nhau đi để\n"
	.string "khi nào cần thì liên lạc.$"

Route104_Text_RegisteredMay:
	.string "{PLAYER} lưu số PHƯƠNG\n"
	.string "vô BẢN ĐỒ.$"

Route104_Text_MayHowsYourPokedex:
	.string "PHƯƠNG: Ủa mà, {PLAYER} ơi,\n"
	.string "DS.POKéMON của ông sao rồi?$"

Route104_Text_MayMinesDecentLetsBattle:
	.string "Của tui cũng được rồi.\n"
	.string "Vậy…\l"
	.string "Làm thử 1 trận nha?$"

Route104_Text_MayHaventRaisedPokemon:
	.string "PHƯƠNG: Ủa sao dạ?\p"
	.string "Ông không có bắt POKéMON\n"
	.string "hay chưa luyện đủ cấp?\p"
	.string "NHL mà vậy là không có được đâu nha!$"

Route104_Text_MayLetsBattle:
	.string "PHƯƠNG: Vậy, ông nghĩ sao?\n"
	.string "Làm thử 1 trận coi sao nha?$"

Route104_Text_MayIntro:
	.string "PHƯƠNG: Ông chỉ mới làm NHL thôi,\n"
	.string "{PLAYER}. Tui sẽ thắng ông cho coi!$"

Route104_Text_MayDefeat:
	.string "Trời đất ơi!\n"
	.string "Tưởng đâu ông yếu lắm ai dè!$"

Route104_Text_MayPostBattle:
	.string "PHƯƠNG: Nhìn cách ông chiến đấu là\n"
	.string "biết ông chăm POKéMON tốt cỡ nào rồi.\p"
	.string "Nhưng mà thay vì chỉ đi thách đấu,\n"
	.string "ông nên học hỏi ÔNG THU đi.\p"
	.string "Làm bạn với POKéMON cũng\n"
	.string "quan trọng không kém đâu.$"

Route104_Text_BrendanWeShouldRegister:
	.string "DŨNG: Ủa, ê, {PLAYER}!\p"
	.string "Chời chời, công ty DEVON cài\n"
	.string "chức năng GỌI ĐIỆN cho bà luôn hả?\p"
	.string "Vậy lưu số tui luôn vô BẢN ĐỒ\n"
	.string "luôn đi để có gì cần thì gọi.$"

Route104_Text_RegisteredBrendan:
	.string "{PLAYER} lưu số DŨNG\n"
	.string "vô BẢN ĐỒ.$"

Route104_Text_BrendanHowsYourPokedex:
	.string "DŨNG: {PLAYER}, DS.POKéMON sao rồi?\n"
	.string "Có điền thêm được trang nào chưa?$"

Route104_Text_BrendanDoingGreatLetsBattle:
	.string "Tui là tui đang làm tốt lắm đó!\p"
	.string "Nếu không tin thì thách\n"
	.string "đấu với tui 1 trận coi sao?$"

Route104_Text_BrendanNoConfidence:
	.string "DŨNG: Sao vậy? Không tin\n"
	.string "tưởng POKéMON của mình à?$"

Route104_Text_BrendanLetsBattle:
	.string "DŨNG: Sao rồi?\n"
	.string "Đấu với tui 1 trận nha?$"

Route104_Text_BrendanIntro:
	.string "DŨNG: Tui biết bà mới làm NHL thôi,\n"
	.string "nhưng tui sẽ không nương tay đâu!$"

Route104_Text_BrendanDefeat:
	.string "Hừm…\n"
	.string "Cũng ghê gớm đó chớ.$"

Route104_Text_BrendanPostBattle:
	.string "DŨNG: Bà cũng biết cách\n"
	.string "chiến đấu với POKéMON đó.\p"
	.string "Mà, nè, chỉ thách đấu POKéMON\n"
	.string "thôi thì không được đâu.\p"
	.string "Kết thân với POKéMON cũng quan trọng\n"
	.string "lắm đó, giống ÔNG THU vậy á.$"
